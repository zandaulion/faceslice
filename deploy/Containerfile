FROM docker.io/library/python:3.13-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

# MediaPipe se leagă de bibliotecile grafice chiar şi când rulează pe procesor:
# fără ele, importul cade cu „libEGL.so.1: cannot open shared object file".
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends libegl1 libgles2 libgl1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# MediaPipe cere `opencv-contrib-python`, varianta cu interfaţă grafică. Nu ne
# trebuie pe un server fără ecran, şi cântăreşte peste o sută de megaocteţi. Se
# scoate şi se pune cea headless în loc -- ambele scriu în acelaşi `cv2`, deci
# ordinea contează: dezinstalarea uneia le ia pe amândouă.
#
# `matplotlib` rămâne, oricât ar părea de nelalocul lui: mediapipe îl importă
# din `tasks.vision.drawing_utils` chiar la încărcarea modulului, deci fără el
# nici nu porneşte.
RUN pip install --no-cache-dir -r requirements.txt \
 && pip uninstall -y opencv-contrib-python \
 && pip install --no-cache-dir --no-deps --force-reinstall opencv-contrib-python-headless==5.0.0.93 \
 && python -c "import cv2, mediapipe, onnxruntime, scipy; print('import ok')"

# Modelele intră în imagine, nu pe volum: sunt cod, nu datele cuiva, iar o
# imagine care şi le descarcă la pornire nu mai e reproductibilă.
COPY models ./models
RUN chmod -R a+rX ./models
COPY server ./server
COPY web ./web

RUN useradd --system --uid 10011 --no-create-home appuser \
 && mkdir -p /data && chown 10011:10011 /data
VOLUME /data
ENV DATA_DIR=/data MODEL_DIR=/app/models WEB_DIR=/app/web PYTHONPATH=/app/server

USER 10011
EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
